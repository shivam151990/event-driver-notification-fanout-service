# Local development only. Generate a different random key for every environment.
# Example: openssl rand -hex 32
FANOUT_API_KEY=local-development-key-replace-before-use-0123456789
DB_PASSWORD=fanout-local-only
# Enable both only when intentionally testing a local/private webhook receiver.
FANOUT_DELIVERY_ALLOW_HTTP=false
FANOUT_DELIVERY_ALLOW_PRIVATE_ADDRESSES=false
